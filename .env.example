# ==================== SERVER ====================
BASE_URL=http://localhost:3000

# ==================== SUPABASE ====================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ==================== GEMINI ====================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Fastest current free-tier model — good default for voice latency.
GEMINI_MODEL=gemini-3.1-flash-lite

# ==================== ORGANIZATION ====================
ORG_ID=00000000-0000-0000-0000-000000000001
ORG_NAME=Skyline Realty
ORG_CITY_FOCUS=Noida, Greater Noida, Gurgaon, Pune, Indore, Bhopal, Jabalpur
ORG_HOURS=Mon-Sat 10:00-19:00 IST
ORG_CONTACT=+91-9999999999
# Same number, exposed to the browser for the landing page's "tel:" links.
NEXT_PUBLIC_ORG_CONTACT=+91-9999999999

# ==================== DASHBOARD / API AUTH ====================
# Gates /dashboard and its data API (/api/test/*, /api/voice/*) behind a
# single shared password. Generate a random SESSION_SECRET (e.g.
# `openssl rand -hex 32`) — it just signs the session cookie, nobody types it.
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
SESSION_SECRET=YOUR_RANDOM_SESSION_SECRET

# ==================== GOOGLE CALENDAR (site-visit booking) ====================
# Create a Google Cloud service account, enable the Calendar API, share your
# team's calendar with the service account's email (Settings and sharing ->
# Share with specific people), then fill these in.
GOOGLE_SERVICE_ACCOUNT_EMAIL=YOUR_SERVICE_ACCOUNT@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=YOUR_SERVICE_ACCOUNT_PRIVATE_KEY
GOOGLE_CALENDAR_ID=YOUR_CALENDAR_ID@group.calendar.google.com

# ==================== SARVAM AI (voice STT + TTS) ====================
# Required — there is no fallback key baked into the code (and there never
# should be; a previous version had a live key hardcoded in source, which is
# a serious security issue — see the note in the chat).
SARVAM_API_KEY=YOUR_SARVAM_API_KEY

# ==================== WHATSAPP (Meta Cloud API) ====================
WHATSAPP_VERIFY_TOKEN=realty_ai_verify_token
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_CLOUD_API_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_API_VERSION=v20.0

# ==================== TWILIO (Voice) ====================
# Used to verify that /webhooks/voice/* requests genuinely come from Twilio.
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN

# ==================== META (Instagram + Facebook Messenger) ====================
META_VERIFY_TOKEN=realty_ai_verify_token
META_WEBHOOK_VERIFY_TOKEN=realty_ai_verify_token
META_APP_SECRET=YOUR_META_APP_SECRET
META_PAGE_ACCESS_TOKEN=YOUR_FACEBOOK_PAGE_ACCESS_TOKEN
META_INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN
INSTAGRAM_APP_SECRET=YOUR_INSTAGRAM_APP_SECRET

# ==================== DEBOUNCE ====================
DEBOUNCE_MS=6000
