# ==================== SERVER ====================
PORT=3000
BASE_URL=http://localhost:3000

# ==================== SUPABASE ====================
# Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ==================== GEMINI ====================
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# ==================== ORGANIZATION (dummy demo org) ====================
ORG_ID=00000000-0000-0000-0000-000000000001
ORG_NAME=Skyline Realty
ORG_CITY_FOCUS=Noida, Greater Noida, Gurgaon, Pune
ORG_HOURS=Mon-Sat 10:00-19:00 IST
ORG_CONTACT=+91-9999999999

# ==================== META (WhatsApp Cloud API) ====================
WHATSAPP_VERIFY_TOKEN=realty_ai_verify_token
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_CLOUD_API_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_API_VERSION=v20.0

# ==================== META (Instagram + Facebook Messenger) ====================
META_VERIFY_TOKEN=realty_ai_verify_token
IG_PAGE_ACCESS_TOKEN=YOUR_INSTAGRAM_PAGE_ACCESS_TOKEN
FB_PAGE_ACCESS_TOKEN=YOUR_FACEBOOK_PAGE_ACCESS_TOKEN

# ==================== TWILIO (Voice calling) ====================
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ==================== DEBOUNCE ====================
# Milliseconds to wait & buffer rapid-fire messages from the same user before replying once
DEBOUNCE_MS=6000
